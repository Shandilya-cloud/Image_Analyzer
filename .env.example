# Web interface login
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-long-password

# Provider default: ollama or openai
DEFAULT_PROVIDER=ollama

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=pdurlej/qwythos-9b-claude-mythos-5-1m:latest
OLLAMA_USERNAME=
OLLAMA_PASSWORD=

# OpenAI SDK (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

MAX_IMAGES=10
MAX_IMAGE_MB=15
